}
.modal.abierto .modal__caja { transform: none; }
.modal__cerrar { position: absolute; top: .75rem; right: .75rem; background: var(--fondo); color: var(--texto); }
.modal__cerrar:hover { background: var(--azul-claro); }
.modal__titulo { padding-right: 2.5rem; font-size: 2.1rem; color: var(--azul); }
