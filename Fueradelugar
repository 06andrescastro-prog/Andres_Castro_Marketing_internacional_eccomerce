/* ---------- MODAL DE COMPRA ---------- */
.modal {
  position: fixed;
  inset: 0;
  z-index: 110;
  display: grid;
  place-items: center;
  padding: 16px;
  opacity: 0;
  visibility: hidden;
  transition: opacity .25s ease, visibility 0s linear .25s;
}
.modal.abierto { opacity: 1; visibility: visible; transition: opacity .25s ease; }
.modal__fondo { position: absolute; inset: 0; background: rgba(15, 20, 32, .65); }
.modal__caja {
  position: relative;
  width: min(500px, 100%);
  max-height: calc(100dvh - 32px);
  overflow-y: auto;
  padding: 2rem 1.5rem 1.5rem;
  border-top: 6px solid var(--amarillo);
  border-radius: calc(var(--radio) * 1.2);
  background: var(--blanco);
