   y queda visible el recuadro de respaldo (👕 / 🧢). */
function crearImagen(src, alt) {
  const img = document.createElement("img");
  img.src = src;
  img.alt = alt;
  img.loading = "lazy";
  img.decoding = "async";
  img.width = 600;
  img.height = 600;
  img.addEventListener("error", () => img.remove());
  return img;
}

/* ==========================================================
