.toast.visible { opacity: 1; transform: translate(-50%, 0); }

/* ---------- ANIMACIÓN AL HACER SCROLL ---------- */
.revelar { opacity: 0; transform: translateY(20px); transition: opacity .6s ease, transform .6s ease; }
